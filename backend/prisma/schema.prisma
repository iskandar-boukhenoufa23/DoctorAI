generator client { 
  provider = "prisma-client-js" 
}
datasource db { 
  provider = "postgresql" 
  url = env("DATABASE_URL") 
}
enum Role { 
  PATIENT
  ADMIN 
}
enum ConsultationStatus { 
  ACTIVE 
  COMPLETED 
  CANCELLED
  ESCALATED 
}
enum MessageRole { 
  PATIENT 
  DOCTOR 
  SYSTEM 
}
model User {
  id String @id @default(cuid())
  clerkId String @unique
  role Role @default(PATIENT)
  email String?
  fullName String?
  avatarUrl String?
  dateOfBirth DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  consultations Consultation[]
  reviews DoctorReview[]
}
model Specialist {
  id String @id @default(cuid())
  slug String @unique
  name String @unique
  description String?
  isActive Boolean @default(true)
  doctors DoctorAgent[]
}
model DoctorAgent {
  id String @id @default(cuid())
  name String
  specialistId String
  specialist Specialist @relation(fields:[specialistId], references:[id])
  description String?
  systemPrompt String @db.Text
  personality Json?
  avatarUrl String?
  modelName String @default("gpt-4o-mini")
  temperature Float @default(0.2)
  isActive Boolean @default(true)
  promptVersion Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  consultations Consultation[]
  reviews DoctorReview[]
}
model Consultation {
  id String @id @default(cuid())
  patientId String
  patient User @relation(fields:[patientId],references:[id])
  doctorId String?
  doctor DoctorAgent? @relation(fields:[doctorId],references:[id])
  title String?
  status ConsultationStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages Message[]
  reviews DoctorReview[]
  triageEvents TriageEvent[]
  @@index([patientId,createdAt])
}
model Message {
  id String @id @default(cuid())
  consultationId String
  consultation Consultation @relation(fields:[consultationId],references:[id],onDelete:Cascade)
  role MessageRole
  content String @db.Text
  metadata Json?
  createdAt DateTime @default(now())
  @@index([consultationId,createdAt])
}
model DoctorReview {
  id String @id @default(cuid())
  patientId String
  patient User @relation(fields:[patientId],references:[id])
  doctorId String
  doctor DoctorAgent @relation(fields:[doctorId],references:[id])
  consultationId String @unique
  consultation Consultation @relation(fields:[consultationId],references:[id])
  rating Int
  comment String?
  createdAt DateTime @default(now())
  @@index([doctorId])
}
model TriageEvent {
  id String @id @default(cuid())
  consultationId String
  consultation Consultation @relation(fields:[consultationId],references:[id],onDelete:Cascade)
  specialtySlug String?
  urgency String
  reason String?
  needsClarification Boolean @default(false)
  modelVersion String?
  createdAt DateTime @default(now())
}
